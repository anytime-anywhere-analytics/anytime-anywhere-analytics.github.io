    "role": "Director · Villum Investigator",
    "org": "Aarhus University",
    "group": "faculty",
    "areas": [
      "Immersive Analytics",
      "Ubiquitous Analytics",
      "Human-Centered AI"
    ],
    "bio": "Niklas Elmqvist is a Villum Investigator and Professor of Computer Science at Aarhus University, where he directs the Center for Anytime Anywhere Analytics. His work asks how data analysis can leave the desktop: how visual representations behave when they are carried, worn, projected, and shared. Before Aarhus he was a professor at the University of Maryland, College Park, and at Purdue University.",
    "links": [
      [
        "Personal site",
        "https://cs.au.dk/~elm/"
      ]
    ],
    "photo": "/assets/people/niklas.jpg"
