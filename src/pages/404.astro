---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found · CA³" noindex>
  <div class="wrap" style="min-height:calc(100vh - 120px)">
    <div class="pagehero">
      <div>
        <h1>Page not found</h1>
        <p class="lead" style="margin-top:20px;max-width:46ch">Nothing lives at this address. It may have moved when the site was rebuilt — try search, or start from one of these.</p>
        <div style="margin-top:28px;display:flex;gap:12px;flex-wrap:wrap">
          <a class="btn" href="/">Home</a>
          <a class="btn ghost" href="/publications/">Publications</a>
          <a class="btn ghost" href="/people/">People</a>
          <a class="btn ghost" href="/news/">News</a>
        </div>
      </div>
    </div>
  </div>
</Base>
